# Copia este archivo a:  ~/orbyx-migration.env   (fuera del repo) y completa los valores.
# En Windows (Git Bash), ~ es C:\Users\camil.  NUNCA lo subas a git: tiene contraseñas y claves.

OLD_REF=vmxjqhndepvgoexajtfc
NEW_REF=fqmdcbvtrgcnftlwcojc

# URI "Session pooler" (puerto 5432) de cada proyecto, con la contraseña real.
# Supabase -> botón Connect -> Session pooler.  Formato:
#   postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Si la contraseña tiene caracteres raros (@ : / # ?) hay que codificarlos (ej. @ = %40).
OLD_DB_URL=
NEW_DB_URL=

# API de cada proyecto (para copiar Storage y para pruebas)
OLD_SUPABASE_URL=https://vmxjqhndepvgoexajtfc.supabase.co
NEW_SUPABASE_URL=https://fqmdcbvtrgcnftlwcojc.supabase.co
# Llave secreta: "service_role" (empieza con eyJ...) o "secret" (empieza con sb_secret_...)
OLD_SERVICE_ROLE_KEY=
NEW_SERVICE_ROLE_KEY=
# Llave pública del proyecto NUEVO: "anon" (eyJ...) o "publishable" (sb_publishable_...)
NEW_ANON_KEY=

# Opcionales
SITE_URL=https://www.orbyx.cl
API_URL=https://api.orbyx.cl
# OUT_DIR=/c/Users/camil/orbyx-migration-out
